# ── Build stage ──────────────────────────────────────────
FROM oven/bun:1 AS builder

WORKDIR /app

COPY package.json bun.lock ./
COPY apps/s4s-connect/package.json ./apps/s4s-connect/
COPY apps/api/package.json ./apps/api/
COPY apps/gest4s/package.json ./apps/gest4s/
COPY packages/types/package.json ./packages/types/
COPY packages/ui/package.json ./packages/ui/

RUN bun install --frozen-lockfile

COPY apps/s4s-connect ./apps/s4s-connect
COPY apps/api ./apps/api
COPY packages/types ./packages/types
COPY packages/ui ./packages/ui

WORKDIR /app/apps/s4s-connect

RUN bun run build

# ── Runtime stage ─────────────────────────────────────────
FROM nginx:alpine AS runner

COPY --from=builder /app/apps/s4s-connect/dist /usr/share/nginx/html
COPY apps/s4s-connect/nginx.connect.conf /etc/nginx/conf.d/default.conf
EXPOSE 80