# ── Build stage ──────────────────────────────────────────
FROM oven/bun:1 AS builder

WORKDIR /app

COPY package.json bun.lockb ./
COPY apps/s4s-connect/package.json ./apps/s4s-connect/
COPY packages/types/package.json ./packages/types/

RUN bun install --frozen-lockfile

COPY apps/s4s-connect ./apps/s4s-connect
COPY packages/types ./packages/types

WORKDIR /app/apps/s4s-connect

RUN bun run build

# ── Runtime stage ─────────────────────────────────────────
FROM nginx:alpine AS runner

COPY --from=builder /app/apps/s4s-connect/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80