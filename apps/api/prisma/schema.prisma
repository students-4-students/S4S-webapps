// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Role {
  PARTICIPANT
  STAFF
  ADMIN
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ScheduleType {
  LECTURE
  EXERCISE
  WORKSHOP
  ACTIVITY
  FREE
}

enum TaskCategory {
  LOGISTIQUE
  MATERIEL
  ANIMATION
  PEDAGOGIE
  COMMUNICATION
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

// ─── CORE MODELS ──────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role             Role     @default(PARTICIPANT)
  sectionId        String?
  section          Section? @relation(fields: [sectionId], references: [id])
  telegramUsername String?  @unique // e.g. "@johndoe" — validated at API layer
  telegramChatId   String?  @unique // set by the bot on first /start
  createdAt        DateTime @default(now())

  pollResponses     PollResponse[]
  reportedIncidents Incident[]     @relation("ReportedIncidents")
  assignedIncidents Incident[]     @relation("AssignedIncidents")
  staffProfile      StaffMember?
}

model Section {
  id            String         @id @default(uuid())
  name          String
  users         User[]
  scheduleSlots ScheduleSlot[]
}

// ─── SCHEDULE ─────────────────────────────────────────────────────────────────

model ScheduleSlot {
  id          String       @id @default(uuid())
  title       String
  description String?
  type        ScheduleType
  startTime   DateTime
  endTime     DateTime
  location    String?
  sectionId   String?
  section     Section?     @relation(fields: [sectionId], references: [id])
}

// ─── STAFF ────────────────────────────────────────────────────────────────────

// Represents a physical staff member, optionally linked to a User account
model StaffMember {
  id        String      @id @default(uuid())
  userId    String?     @unique
  user      User?       @relation(fields: [userId], references: [id])
  firstName String
  lastName  String
  role      String
  status    StaffStatus @default(ACTIVE)
  isPresent        Boolean @default(false)
  telegramUsername String?
  telegramChatId   String?
  phone            String?
  email     String?
  createdAt DateTime    @default(now())

  shifts          Shift[]
  taskAssignments TaskAssignment[]
}

// A shift is a scheduled time block for a staff member
model Shift {
  id            String      @id @default(uuid())
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  startTime     DateTime
  endTime       DateTime
  location      String?
  notes         String?
}

// ─── TASKS ────────────────────────────────────────────────────────────────────

model Task {
  id          String       @id @default(uuid())
  name        String
  description String?
  category    TaskCategory
  startTime   DateTime
  endTime     DateTime
  location    String?
  status      TaskStatus   @default(PENDING)
  priority    Priority     @default(MEDIUM)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assignments TaskAssignment[]
}

model TaskAssignment {
  id            String      @id @default(uuid())
  taskId        String
  task          Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@unique([taskId, staffMemberId])
}

// ─── INCIDENTS ────────────────────────────────────────────────────────────────

model Incident {
  id           String         @id @default(uuid())
  title        String
  description  String
  location     String?
  category     String?
  severity     Severity       @default(LOW)
  status       IncidentStatus @default(OPEN)
  reportedById String
  reportedBy   User           @relation("ReportedIncidents", fields: [reportedById], references: [id])
  assignedTo   User[]         @relation("AssignedIncidents")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ─── POLLS ────────────────────────────────────────────────────────────────────

model Poll {
  id         String         @id @default(uuid())
  question   String
  targetRole Role
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  options    PollOption[]
  responses  PollResponse[]
}

model PollOption {
  id        String         @id @default(uuid())
  label     String
  pollId    String
  poll      Poll           @relation(fields: [pollId], references: [id])
  responses PollResponse[]
}

model PollResponse {
  id       String     @id @default(uuid())
  userId   String
  pollId   String
  optionId String
  user     User       @relation(fields: [userId], references: [id])
  poll     Poll       @relation(fields: [pollId], references: [id])
  option   PollOption @relation(fields: [optionId], references: [id])

  @@unique([userId, pollId])
}

// ─── FILES ────────────────────────────────────────────────────────────────────

model File {
  id         String   @id @default(uuid())
  name       String
  mimeType   String
  size       Int
  bucket     String
  key        String
  uploadedAt DateTime @default(now())
}
