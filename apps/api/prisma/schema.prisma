generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  password              String
  firstName             String
  lastName              String
  role                  Role                   @default(PARTICIPANT)
  sectionId             String?
  createdAt             DateTime               @default(now())
  telegramChatId        String?                @unique
  telegramUsername      String?                @unique
  reportedIncidents     Incident[]             @relation("ReportedIncidents")
  pollResponses         PollResponse[]
  staffProfile          StaffMember?
  section               Section?               @relation(fields: [sectionId], references: [id])
  assignedIncidents     Incident[]             @relation("AssignedIncidents")
  workshopRegistrations WorkshopRegistration[]
  firstDayGroup         String?
  QRScannedAt           DateTime?
  welcomeEmailSentAt    DateTime?
  passwordConfigured    Boolean                @default(false)
  surveyResponses       SurveyResponse[]
  workshopFavorites     WorkshopFavorite[]
}

model Section {
  id            String         @id @default(uuid())
  name          String
  scheduleSlots ScheduleSlot[]
  users         User[]
  Class         Class[]
  slots         ScheduleSlot[] @relation("ScheduleSlotSections")
}

model ScheduleSlot {
  id          String       @id @default(uuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  location    String?
  roomId      String?
  room        Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  sectionId   String?
  targetGroup String?      // null = all students, 'A' = Groupe A, 'B' = Groupe B
  type        ScheduleType
  assistantId String?
  speakerId   String?
  rcId        String?
  assistant   StaffMember? @relation("AssistantSlots", fields: [assistantId], references: [id])
  rc          StaffMember? @relation("RcSlots", fields: [rcId], references: [id])
  section     Section?     @relation(fields: [sectionId], references: [id])
  speaker     StaffMember? @relation("SpeakerSlots", fields: [speakerId], references: [id])
  sections    Section[]    @relation("ScheduleSlotSections")
}

model StaffMember {
  id                     String           @id @default(uuid())
  userId                 String?          @unique
  firstName              String
  lastName               String
  role                   String
  status                 StaffStatus      @default(ACTIVE)
  isPresent              Boolean          @default(false)
  telegramUsername       String?
  telegramChatId         String?
  phone                  String?
  email                  String?
  createdAt              DateTime         @default(now())
  score                  Int              @default(0)
  assistantSlots         ScheduleSlot[]   @relation("AssistantSlots")
  rcSlots                ScheduleSlot[]   @relation("RcSlots")
  speakerSlots           ScheduleSlot[]   @relation("SpeakerSlots")
  shifts                 Shift[]
  user                   User?            @relation(fields: [userId], references: [id])
  taskAssignments        TaskAssignment[]
  Class_AssistantClasses Class[]          @relation("AssistantClasses")
  Class_RcClasses        Class[]          @relation("RcClasses")
  Class_SpeakerClasses   Class[]          @relation("SpeakerClasses")
  readWriteClasses       Class[]          @relation("ClassReadWriteStaff")
  readOnlyClasses        Class[]          @relation("ClassReadOnlyStaff")
}

model Shift {
  id            String      @id @default(uuid())
  staffMemberId String
  startTime     DateTime
  endTime       DateTime
  location      String?
  type          String?
  notes         String?
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
}

model Task {
  id          String           @id @default(uuid())
  name        String
  description String?
  category    TaskCategory
  startTime   DateTime
  endTime     DateTime
  location    String?
  roomId      String?
  room        Room?            @relation(fields: [roomId], references: [id], onDelete: SetNull)
  status      TaskStatus       @default(PENDING)
  priority    Priority         @default(MEDIUM)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  assignments TaskAssignment[]
}

model TaskAssignment {
  id            String      @id @default(uuid())
  taskId        String
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  task          Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, staffMemberId])
}

model Incident {
  id           String         @id @default(uuid())
  title        String
  description  String
  severity     Severity       @default(LOW)
  status       IncidentStatus @default(OPEN)
  reportedById String
  createdAt    DateTime       @default(now())
  category     String?
  location     String?
  updatedAt    DateTime       @updatedAt
  reportedBy   User           @relation("ReportedIncidents", fields: [reportedById], references: [id])
  assignedTo   User[]         @relation("AssignedIncidents")
}

model Poll {
  id         String         @id @default(uuid())
  question   String
  targetRole Role
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  options    PollOption[]
  responses  PollResponse[]
}

model PollOption {
  id        String         @id @default(uuid())
  label     String
  pollId    String
  poll      Poll           @relation(fields: [pollId], references: [id])
  responses PollResponse[]
}

model PollResponse {
  id       String     @id @default(uuid())
  userId   String
  pollId   String
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id])
  poll     Poll       @relation(fields: [pollId], references: [id])
  user     User       @relation(fields: [userId], references: [id])

  @@unique([userId, pollId])
}

// ─── FEEDBACK / SURVEYS ────────────────────────────────────────────────────────

enum QuestionType {
  LIKERT_5      // "Tout à fait d'accord, D'accord, pas d'accord, Pas du tout d'accord, sans avis"
  OPEN_TEXT     // Texarea open text answer
  SINGLE_CHOICE // Single choice option
  MULTIPLE      // Multiple choices option (checkboxes)
}

model Survey {
  id          String           @id @default(uuid())
  title       String
  description String?
  active      Boolean          @default(true)
  availableAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  pages       SurveyPage[]
  responses   SurveyResponse[]
}

model SurveyPage {
  id          String           @id @default(uuid())
  surveyId    String
  survey      Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int              @default(0)
  questions   SurveyQuestion[]
}

model SurveyQuestion {
  id          String         @id @default(uuid())
  pageId      String
  page        SurveyPage     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        QuestionType
  required    Boolean        @default(true)
  order       Int            @default(0)
  options     SurveyOption[]
  answers     SurveyAnswer[]
}

model SurveyOption {
  id         String         @id @default(uuid())
  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  order      Int            @default(0)
  answers    SurveyAnswer[]
}

model SurveyResponse {
  id        String         @id @default(uuid())
  surveyId  String
  survey    Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  answers   SurveyAnswer[]

  @@unique([surveyId, userId])
}

model SurveyAnswer {
  id          String         @id @default(uuid())
  responseId  String
  response    SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId  String
  question    SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId    String?        
  option      SurveyOption?  @relation(fields: [optionId], references: [id], onDelete: SetNull)
  textAnswer  String?        
}

model File {
  id          String    @id @default(uuid())
  name        String
  mimeType    String
  size        Int
  bucket      String
  key         String
  uploadedAt  DateTime  @default(now())
  availableAt DateTime?
  folderId    String?
  classId     String?
  Class       Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)
  Folder      Folder?   @relation(fields: [folderId], references: [id], onDelete: Cascade)
}

model Class {
  id                           String        @id
  name                         String
  createdAt                    DateTime      @default(now())
  File                         File[]
  Folder                       Folder[]
  StaffMember_AssistantClasses StaffMember[] @relation("AssistantClasses")
  Section                      Section[]
  StaffMember_RcClasses        StaffMember[] @relation("RcClasses")
  StaffMember_SpeakerClasses   StaffMember[] @relation("SpeakerClasses")
  
  // Custom access permissions for Staff
  readWriteStaff               StaffMember[] @relation("ClassReadWriteStaff")
  readOnlyStaff                StaffMember[] @relation("ClassReadOnlyStaff")
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  classId   String
  parentId  String?
  File      File[]
  Class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  parent    Folder?  @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderToFolder")
}

enum Role {
  PARTICIPANT
  STAFF
  ADMIN
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ScheduleType {
  LECTURE
  EXERCISE
  WORKSHOP
  ACTIVITY
  FREE
  SPECIAL
  MEAL
}

enum TaskCategory {
  LOGISTIQUE
  MATERIEL
  ANIMATION
  PEDAGOGIE
  COMMUNICATION
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

// ─── WORKSHOPS ────────────────────────────────────────────────────────────────

model Workshop {
  id                      String            @id @default(uuid())
  title                   String
  location                String
  roomId                  String?
  room                    Room?             @relation("WorkshopRooms", fields: [roomId], references: [id], onDelete: SetNull)
  description             String
  image                   String?           // image URL or path
  category                String?           @default("Workshop") // "Workshop", "Conférences", etc.
  requiresRegistration    Boolean           @default(false)
  onlyOneSlotPerUser      Boolean           @default(false)   // User can only register to 1 slot of this workshop
  isRegistrationClosed    Boolean           @default(false)   // Registrations closed by admin
  externalRegistrationUrl String?           // URL to external registration form (Google Form, etc.)
  maxParticipants         Int?              // Null means unlimited or not applicable
  dates                   WorkshopSession[]
  favorites               WorkshopFavorite[]
  createdAt               DateTime          @default(now())
}

// ─── ROOM MANAGEMENT ─────────────────────────────────────────────────────────

model Room {
  id               String             @id @default(uuid())
  name             String             @unique
  building         String?
  floor            Int?               @default(0)
  capacity         Int?
  isComputerRoom   Boolean            @default(false)
  description      String?
  latitude         Float?
  longitude        Float?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  availabilities   RoomAvailability[]
  scheduleSlots    ScheduleSlot[]
  workshops        Workshop[]         @relation("WorkshopRooms")
  workshopSessions WorkshopSession[]  @relation("WorkshopSessionRooms")
  tasks            Task[]
}

model RoomAvailability {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date      DateTime
  startTime DateTime
  endTime   DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model WorkshopSession {
  id            String                 @id @default(uuid())
  workshopId    String
  workshop      Workshop               @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  startTime     DateTime
  endTime       DateTime
  location      String?
  roomId        String?
  room          Room?                  @relation("WorkshopSessionRooms", fields: [roomId], references: [id], onDelete: SetNull)
  registrations WorkshopRegistration[]
}

model WorkshopRegistration {
  id        String          @id @default(uuid())
  sessionId String
  session   WorkshopSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName String?
  lastName  String?
  email     String?
  isPresent Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@unique([sessionId, userId, email])
}

model WorkshopFavorite {
  id         String   @id @default(uuid())
  userId     String
  workshopId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, workshopId])
}



